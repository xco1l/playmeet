{
  "name": "play-meet",
  "version": "0.5.0",
  "private": true,
  "license": "MIT",
  "description": "A browser ragdoll physics playground using Babylon.js and Havok",
  "packageManager": "pnpm@11.25.0",
  "engines": { "node": ">=24 <25" },
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "test": "node --test --test-isolation=none tests/*.test.mjs",
    "test:public": "node --test --test-isolation=none tests/*.test.mjs",
    "character": "node scripts/create-character.mjs",
    "character:check": "node scripts/create-character.mjs --check",
    "export:source": "node scripts/export-source.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "benchmark": "node scripts/benchmark.mjs",
    "compare": "node scripts/compare-traces.mjs",
    "measure": "node scripts/measure-behavior.mjs"
  },
  "dependencies": {
    "@babylonjs/core": "9.29.0",
    "@babylonjs/havok": "1.3.14"
  },
  "devDependencies": {
    "vite": "^8.3.3"
  }
}
